\section*{References}
<<allom.ref, echo=FALSE, warning=FALSE, error=FALSE, message=FALSE>>=
	# Add allometry citation

	refs <- c(
	"Chave, J., R\\'{e}jou-M\\'{e}chain, M., B\\'{u}rquez, A., Chidumayo, E., Colgan, M. S., Delitti, W. B., ... and Henry, M. (2014). Improved allometric models to estimate the aboveground biomass of tropical trees. Global change biology, 20(10), 3177-3190.\n",
	"Jenkins, J. C., Chojnacky, D. C., Heath, L. S., and Birdsey, R. A. (2003). National-scale biomass estimators for United States tree species. Forest science, 49(1), 12-35.\n",
	"Paul, K. I., Roxburgh, S. H., Chave, J., England, J. R., Zerihun, A., Specht, A., ... and Huxtable, D. (2016). Testing the generality of above-ground biomass allometry across plant functional types at the continent scale. Global change biology, 22(6), 2106-2124.\n",
	"Muukkonen, P. (2007). Generalized allometric volume and biomass equations for some tree species in Europe. European Journal of Forest Research, 126(2), 157-166.\n",
	"Moore, J. R. (2010). Allometric equations to predict the total above-ground biomass of radiata pine trees. Annals of Forest Science, 67(8), 806.\n",
	"Beets, P. N., Reutebuch, S., Kimberley, M. O., Oliver, G. R., Pearce, S. H., and McGaughey, R. J. (2011). Leaf area index, biomass carbon and growth rate of radiata pine genetic types and relationships with LiDAR. Forests, 2(3), 637-659.\n",
	"Forrester, D. I., Tachauer, I. H. H., Annighoefer, P., Barbeito, I., Pretzsch, H., Ruiz-Peinado, R., ... and Saha, S. (2017). Generalized biomass and leaf area allometric equations for European tree species incorporating stand structure, tree age and climate. Forest ecology and management, 396, 160-175.\n"
	)

	
	
	reference <- paste(refs, collapse='\n \\setlength{\\parindent}{-0.2in}
\\setlength{\\leftskip}{0.2in}
\\setlength{\\parskip}{8pt} ')
	

	
@
% References 

\hangindent=0.2in \Sexpr{reference}


\end{document}
