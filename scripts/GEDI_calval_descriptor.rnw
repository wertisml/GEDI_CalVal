<<allomDef, warning=FALSE, error=FALSE, echo=FALSE, message=FALSE, results='asis'>>=

	## Inserting the field sampling metadata

	options(xtable.comment=FALSE)
	rws <- c(seq(1, (nrow(allomDef)-1), by = 2),0)
