<<makeContent, echo=FALSE, warning=FALSE, error=FALSE, message=FALSE>>=
	suppressWarnings(suppressMessages(library(data.table)))
	suppressWarnings(suppressMessages(library(xtable)))
	suppressWarnings(suppressMessages(library(plyr)))
	suppressWarnings(suppressMessages(library(ggplot2)))
	suppressWarnings(suppressMessages(library(scales)))
	suppressWarnings(suppressMessages(library(ggmap)))
	suppressWarnings(suppressMessages(library(rjson)))
	suppressWarnings(suppressMessages(library(gtable)))
	suppressWarnings(suppressMessages(library(BIOMASS)))
	suppressWarnings(suppressMessages(library(grid)))
	suppressWarnings(suppressMessages(library(gridExtra)))
	suppressWarnings(suppressMessages(library(dplyr)))
	suppressWarnings(suppressMessages(library(xml2)))
	suppressWarnings(suppressMessages(library(pracma)))
	suppressWarnings(suppressMessages(library(rhdf5)))
	source("../R/support.R")
 
# Load the data from most recent RDS file

#	rds.files <- list.files(path="../shiny", pattern="^gedicalval_........_r..\\.rds$")
#rds.files <- list.files(path="../shiny", pattern=paste("^gedicalval_", reportproject, "_........_r..\\.rds$", sep=""))

	#rds.file.full <- list.files(path="../shiny", pattern="^gedicalval_20210512_r03\\.rds$")
	#rds.file.full <- list.files(path="../shiny", pattern="^gedicalval_20221111_r03\\.rds$")
	#rds.file.full <- "base_allometries/gedi_fsbd_public_20230823.rds"
	rds.file.full <- list.files(path="../shiny", pattern="^gedicalval_20231011_r03\\.rds$")

rds.files <- list.files(path="../shiny", pattern=paste("^gedicalval_", reportproject, "_........_r03\\.rds$", sep=""))

if ( length(rds.files) > 0 ) {
  rds.file <- rds.files[length(rds.files)]
} else {
  rds.file <- "gedicalval.rds"
}
#print(rds.file)
#print(rds.file.full)

gedicalval <- readRDS(paste('..','shiny', rds.file, sep=.Platform$file.sep))
gedicalval.full <- readRDS(paste('..','shiny', rds.file.full, sep=.Platform$file.sep))


dictionary <- rbind(gedicalval$dictionary,gedicalval$footprint)

# Read the metadata
metadata <- metadata_xml_to_dataframe(paste('../data/', reportproject, '/studyMetadata.xml', sep=""))
invisible(list2env(metadata,.GlobalEnv)) # Creates gedi.metadata and submitted.metadata

metadataDefinitions <- read_csv('../config/metadataDefinitions.csv')

meta <- gedicalval$metadata
idx <- meta$project == reportproject




gedi.projectname <- gsub("_", "\\_", reportproject, fixed = TRUE)

Projectname <- gedi.metadata$project
Projectname <- gsub(pattern="_", replacement = " ", as.character(Projectname), fixed = TRUE)
Projectname <- gsub(pattern="project", replacement = "", as.character(Projectname),  fixed = TRUE)

if(!is.na(Projectname)){
  overview <- paste('This report presents source information, metadata and summary data for the ', gedi.projectname,' project in the GEDI Forest Structure and Biomass Database (FSBD). 
							These are derived from data contributed from the "', Projectname, '" project.', sep="")
} else {
  overview <- paste('This report presents source information, metadata and summary data for the ', gedi.projectname,' project in the GEDI Forest Structure and Biomass Database (FSBD).', sep="")	
}

#Create data frame of data custodian information
custodian.df <- data.frame(Contact=gedi.metadata$contact,
                           Email=gedi.metadata$email,
                           Project=gedi.metadata$project,
                           Affiliation=gedi.metadata$source)

#Add minimum plot diameter to the sampling metadata
project.data <- subset(gedicalval$plotdata, project == reportproject)
if(any(!is.na(project.data$sp.mindiam))){
  p.mindiam <- paste(unique(project.data$sp.mindiam), collapse=', ')
} else{
  p.mindiam <- paste(unique(project.data$p.mindiam), collapse=', ')
}

#Check if biomass is from GEDI or data providers
tree.data <- subset(gedicalval$treedata, project == reportproject)

if(any(!is.na(tree.data$d.stem))){
  biomass.source <- "Calculated by GEDI from tree-level data"
} else{
  biomass.source <- "Calculated by data provider"
}

gedi.metadata <- as.data.frame(t(apply(gedi.metadata, 2, as.character)), stringsAsFactors = FALSE)
#Create data frame of field sampling
sampling.df <- as.data.frame(matrix(c('Region', 'Sampling strategy', 'Stem measurement', 
                                      'Height measurement', 'Location measurement', 'Minimum tree diameter (m)',
                                      'Source of biomass estimates',
                                      gedi.metadata$region,
                                      gedi.metadata$sampling.strategy,
                                      gedi.metadata$stem.measurement,
                                      gedi.metadata$height.measurement,
                                      gedi.metadata$location.measurement,
                                      p.mindiam, biomass.source), ncol = 2, nrow=7), stringsAsFactors=FALSE)

colnames(sampling.df) <- c('Item','Value')
	


	project.data <- subset(gedicalval$plotdata, project == reportproject)

	# Create data frame of lidar metadata
	ii <- !duplicated(project.data[,dictionary$variable[dictionary$group=='lidar']]) & !is.na(project.data$l.project)
	lidar.df <- project.data[ii,dictionary$variable[dictionary$group=='lidar']]
	lidar.df$l.epsg <- as.character(as.integer(lidar.df$l.epsg)	)
	colnames(lidar.df) <- c('Aquisition', 'Instrument', 'EPSG code', 'Date')


@
\title{GEDI Forest Structure and Biomass Database: \Sexpr{gedi.projectname} report}
\maketitle
