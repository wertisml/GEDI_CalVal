<<HDplot, echo=FALSE, warning=TRUE, error=TRUE, message=FALSE, fig.height=4, fig.path = paste("./reports/figure/",reportproject,"_",sep=""),  dev=c('png', 'postscript'), dpi=300>>=
	
	# Plot of tree height vs. diameter for the focal project
	tree.data <- subset(gedicalval$treedata, (project == reportproject))
	ii <- !is.na(tree.data[,'h.t']) & !is.na(tree.data[,'d.stem']) & (tree.data[,'status']==1 | is.na(tree.data[,'status']))
	m <- BIOMASS::modelHD(D=tree.data$d.stem[ii], H=tree.data$h.t[ii], method='log1', drawGraph=FALSE)
	intercept <- m$model$coefficients[1]
	coef <- m$model$coefficients[2]

	gg <- ggplot()
	gg <- gg + geom_point(data=tree.data[ii,], 
				aes(x=d.stem, y=h.t), 
				size=1, alpha=0.5, color="black")
	if(any(!is.na(tree.data$h.t.mod[ii]))){
		gg <- gg + geom_line(data=tree.data[ii,], 
				aes_string(x='d.stem', y='h.t.mod'), 
				size=1, alpha=1, color="red")
	}
	gg <- gg + labs(x='Diameter (m)',y='Height (m)') + theme_bw()
	gg <- gg + annotate('text', x = 0.4, y = 80, size=2.5, label = paste0('log(H) = ',round(intercept,2),' + ', round(coef,2),'*log(D)\nRSE = ',round(m$RSE,2), sep=''))
	gg
			
@

  \caption{Tree height vs. tree diameter for the \Sexpr{gedi.projectname} project}
  \label{fig:HDplot}
\end{figure}
\fi

