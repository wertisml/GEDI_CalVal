\begin{landscape}
<<metatab, include=FALSE, echo=FALSE, warning=FALSE, error=FALSE, message=FALSE, results='asis'>>=

	if(exists('submitted.metadata')){
		submitted.metadata <- t(submitted.metadata)
		submitted.metadata <- cbind('variable' = rownames(submitted.metadata), submitted.metadata)
		submitted.metadata <- as.data.frame(apply(submitted.metadata, 2, as.character))
		submitted.metadata <- dplyr::left_join(metadataDefinitions, submitted.metadata, by = "variable" )
		colnames(submitted.metadata)[3:ncol(submitted.metadata)] <- c("Item", rep("Value", ncol(submitted.metadata)-3))
		
		simpleCap <- function(x) {
			paste(toupper(substring(x, 1,1)), substring(x, 2),
			sep="", collapse=" ")
		}
		submitted.metadata$Item <- sapply(submitted.metadata$Item, simpleCap)
		
		options(xtable.comment=FALSE)
		rws <- seq(1, (nrow(submitted.metadata)-1), by = 2)
		col <- rep("\\rowcolor[gray]{0.8} ", length(rws))

		## Inserting the data provider survey metadata
		colwidth <- paste("p{", 8/(ncol(submitted.metadata[,-c(1:2)])), "in}", sep="")
		options(xtable.comment=FALSE)
		key.metadata <- submitted.metadata[submitted.metadata[,2]=='key',-c(1:2)]
		rws <- seq(1, (nrow(key.metadata)-1), by = 2)
		col <- rep("\\rowcolor[gray]{0.8} ", length(rws))
		print.xtable(xtable(submitted.metadata[submitted.metadata[,2]=='key',-c(1:2)],
			caption=paste("Custodian metadata submitted by the data provider for the",gedi.projectname,"project.", sep=" "),
			align=c('p',rep(colwidth,ncol(submitted.metadata[,-c(1:2)]))),
			),
			caption.placement="top",
			include.rownames=FALSE,
			size="\\fontsize{5pt}{10pt}\\selectfont",
			add.to.row = list(pos = as.list(rws), command = col))

		field.metadata <- submitted.metadata[submitted.metadata[,2]=='field',-c(1:2)]
		rws <- seq(1, (nrow(field.metadata)-1), by = 2)
		col <- rep("\\rowcolor[gray]{0.8} ", length(rws))			
		print.xtable(xtable(field.metadata,
			caption=paste("Field metadata submitted by the data provider for the",gedi.projectname,"project.", sep=" "),
			align=c('p',rep(colwidth,ncol(field.metadata))),
			),
			caption.placement="top",
			include.rownames=FALSE,
			size="\\fontsize{5pt}{10pt}\\selectfont",
			add.to.row = list(pos = as.list(rws), command = col))

		lidar.metadata <- submitted.metadata[submitted.metadata[,2]=='lidar',-c(1:2)]
		rws <- seq(1, (nrow(lidar.metadata)-1), by = 2)
		col <- rep("\\rowcolor[gray]{0.8} ", length(rws))			
		print.xtable(xtable(lidar.metadata,
			caption=paste("Lidar metadata submitted by the data provider for the",gedi.projectname,"project.", sep=" "),
			align=c('p',rep(colwidth,ncol(lidar.metadata))),
			),
			caption.placement="top",
			include.rownames=FALSE,
			size="\\fontsize{5pt}{10pt}\\selectfont",
			add.to.row = list(pos = as.list(rws), command = col))
	}
@
\end{landscape}

\end{document}
