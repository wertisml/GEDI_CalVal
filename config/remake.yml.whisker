# remake.yml.whisker
packages:
  - plyr
  - methods
  - devtools
  - terra
  - RCurl
  - ggplot2
  - maps
  - shiny
  - jsonlite
  - BIOMASS
  - tidyr
  - optparse

sources:
  - R

include:
  # This file is automatically generated and is quite large.  It defines
  # targets for each data set, plus the 'gedicalval' target.
  - remake_data_{{label}}.yml

targets:
  all:
    depends:
      - gedicalval
      - export
  everything:
    depends:
      - export

  ## exporting targets
  export:
    depends:
      - shiny/gedicalval_{{label}}.rds
      - export/gedicalval_treedata_{{label}}.csv
      - export/gedicalval_plotdata_{{label}}.csv
      - export/gedicalval_gedidata_{{label}}.csv
      - export/gedicalval_metadata_{{label}}.csv
      - export/gedicalval_dictionary_{{label}}.csv
      - export/gedicalval_footprint_{{label}}.csv
      - export/gedicalval_allometry_{{label}}.csv
      - export/gedicalval_lidar_{{label}}.csv

  shiny/gedicalval_{{label}}.rds:
    command: saveRDS(gedicalval, target_name)
  export/gedicalval_treedata_{{label}}.csv:
    command: write_csv(gedicalval_treedata, target_name)
  export/gedicalval_plotdata_{{label}}.csv:
    command: write_csv(gedicalval_plotdata, target_name)
  export/gedicalval_gedidata_{{label}}.csv:
    command: write_csv(gedicalval_gedidata, target_name)
  export/gedicalval_metadata_{{label}}.csv:
    command: write_csv(gedicalval_metadata, target_name)
  export/gedicalval_dictionary_{{label}}.csv:
    command: write_csv(gedicalval_dictionary, target_name)
  export/gedicalval_footprint_{{label}}.csv:
    command: write_csv(gedicalval_footprint, target_name)
  export/gedicalval_allometry_{{label}}.csv:
    command: write_csv(gedicalval_allometry, target_name)
  export/gedicalval_lidar_{{label}}.csv:
    command: write_csv(gedicalval_lidar, target_name)
    
  ## gedicalval elements
  gedicalval_treedata:
    command: extract_gedicalval_treedata(gedicalval, variable_definitions)
  gedicalval_plotdata:
    command: extract_gedicalval_plotdata(gedicalval)
  gedicalval_gedidata:
    command: extract_gedicalval_gedidata(gedicalval)
  gedicalval_metadata:
    command: extract_gedicalval_metadata(gedicalval)
  gedicalval_dictionary:
    command: extract_gedicalval_dictionary(gedicalval)
  gedicalval_footprint:
    command: extract_gedicalval_footprint(gedicalval)
  gedicalval_allometry:
    command: extract_gedicalval_allometry(gedicalval)
  gedicalval_lidar:
    command: extract_gedicalval_lidar(gedicalval)
